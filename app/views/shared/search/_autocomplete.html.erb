<% input_id = local_assigns.fetch(:input_id, 'q') %>
<% input_name = local_assigns.fetch(:input_name, 'q') %>
<% described_by = local_assigns[:described_by] %>
<% input_value = local_assigns[:input_value] %>
<% input_error = local_assigns[:input_error] %>
<% autofocus = local_assigns[:autofocus] %>
<% if local_assigns[:resource_id].present? %>
  <%= hidden_field_tag :resource_id, local_assigns[:resource_id] %>
  <%= hidden_field_tag :resource_id_query, input_value %>
<% end %>
<div
  class="govuk-fieldset"
  id="autocomplete"
  data-module="search-autocomplete"
  data-input-id="<%= input_id %>"
  data-input-name="<%= input_name %>"
  data-described-by="<%= described_by %>"
  data-input-value="<%= input_value %>"
  <%= 'data-input-error=true' if input_error %>
  <%= 'data-autofocus=true' if autofocus %>
>

  <noscript>
    <div class="autocomplete__wrapper">
      <input autocomplete="off" class="autocomplete__input autocomplete__input--default<%= ' govuk-input--error' if input_error %>" id="<%= input_id %>" name="<%= input_name %>" placeholder="Enter the name of the goods or commodity code" type="text" required="" value="<%= input_value %>" aria-describedby="<%= described_by %>"<%= ' autofocus' if autofocus %>>
    </div>
  </noscript>
</div>
