<% if @ai_search_enabled %>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <%= render 'shared/search/tabbed_search_form', compact: true %>
    </div>
  </div>
<% else %>
  <%= render 'shared/search/classic_search_form', use_date_picker: local_assigns.fetch(:use_date_picker, false) %>
<% end %>
