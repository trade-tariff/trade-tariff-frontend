<%= form_tag '#', method: 'get', class: 'trade-details govuk-!-margin-bottom-7' do %>
  <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Trade details</h2>
  <p class="govuk-body">Select the origin of the commodity to view information for that country.</p>

  <% (params.keys - %w[controller action country service id day month year invalid_date]).each do |param| %>
    <%= hidden_field_tag param, params[param] if params.key?(param) %>
  <% end %>

  <% if @search.errors[:as_of].any? %>
    <div class="govuk-error-summary" data-module="govuk-error-summary">
      <div role="alert">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            <li><a href="#trade-date">You must enter a valid date</a></li>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="trade-details__fields">
    <fieldset class="govuk-fieldset country-picker trade-details__field">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Select a country</legend>
      <%= label_tag :country, 'Where were the goods produced or coming from?', class: 'govuk-label' %>
      <div data-controller="country-select-box">
        <div data-country-select-box-target="countrySelect">
          <%= select_tag :country,
                         options_for_select(GeographicalArea.country_options, params[:country]),
                         class: 'govuk-select trade-details__country-select',
                         data: { action: 'focus->country-select-box#clearSelect' },
                         'aria-label': 'Filter measures by country' %>
        </div>
      </div>
    </fieldset>

    <fieldset class="govuk-fieldset trade-details__field" id="trade-date">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Date of trade</legend>
      <% if @search.errors[:as_of].any? %>
        <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> You must enter a valid date</p>
      <% end %>
      <div class="govuk-date-input">
        <% { day: [2, @search.date.day], month: [2, @search.date.month], year: [4, @search.date.year] }.each do |name, (width, value)| %>
          <div class="govuk-date-input__item">
            <div class="govuk-form-group">
              <%= label_tag name, name.to_s.humanize, class: 'govuk-label govuk-date-input__label' %>
              <%= text_field_tag name,
                                 params[name].presence || value,
                                 class: "govuk-input govuk-date-input__input govuk-input--width-#{width}",
                                 inputmode: 'numeric' %>
            </div>
          </div>
        <% end %>
      </div>
    </fieldset>
  </div>

  <%= button_tag 'Update page', class: 'button search-submit govuk-button govuk-!-margin-bottom-0' %>
<% end %>
