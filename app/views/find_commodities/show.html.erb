<% content_for :title, "Error: #{default_title}" if @search.errors.include?(:keyword_q) %>
<div data-guided-search-validation-page-content>
  <%= page_header 'Find commodity codes, import duties, taxes and controls' %>

  <%= render 'shared/service_switch' %>
  <%= render 'news_items/hero_story', news_item: @hero_story if @hero_story %>

  <div class="govuk-grid-row app-find-commodity-layout">
    <div class="govuk-grid-column-two-thirds app-find-commodity-search">
      <%= render 'find_commodities/revised_search_form' %>
    </div>

    <div class="govuk-grid-column-one-third" id="find-commodity-sidebar">
      <%= render 'find_commodities/parcel_gift_entry' %>
      <%= render '/pages/howto_sidebar_links' %>
      <%= render 'find_commodities/tools' %>
    </div>

    <div class="govuk-grid-column-two-thirds app-find-commodity-news-column">
      <section class="app-find-commodity-news" id="recent-news" aria-labelledby="find-commodity-news-heading">
        <%= render 'news_items/recent_news', news_items: @recent_stories, heading_id: 'find-commodity-news-heading' %>
      </section>
    </div>
  </div>
</div>
<% if @ai_search_enabled %>
  <div data-guided-search-validation-loading-page class="govuk-!-display-none">
    <%= render 'search/interactive_search_thinking' %>
  </div>
<% end %>
