<%# Incomplete fields submit a different date from the one the summary would state, so hide
   the summary and open the fields for the user to finish. %>
<% date_needs_attention = @search.errors[:as_of].any? || @search.partial_date? %>
<div data-controller="date-summary" data-action="input->date-summary#hide change->date-summary#hide">
  <% unless date_needs_attention %>
    <p class="govuk-body-s" data-date-summary-target="summary">
      <%= @search.today? ? "Using today's date," : 'Using' %>
      <strong><%= @search.date.strftime('%-d %B %Y') %></strong>, for duties and quotas.
    </p>
  <% end %>
  <%= govuk_details(summary_text: 'Change date', id: 'find-commodity-date', open: date_needs_attention) do %>
    <%= f.govuk_date_field :as_of,
          legend: { text: 'Change trade date', size: 's', tag: nil },
          hint: { text: safe_join(['Use the date your goods will be traded. Duties and quotas can change over time.', tag.br, tag.br, 'For example 27 3 2021']) },
          form_group: { class: 'govuk-!-margin-bottom-0' }, maxlength_enabled: true %>
  <% end %>
</div>
