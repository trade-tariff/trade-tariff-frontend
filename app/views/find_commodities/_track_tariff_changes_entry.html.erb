<%= app_card(classes: 'app-track-tariff-changes-card', id: 'track-tariff-changes-entry') do %>
  <h2 class="app-track-tariff-changes-card__heading govuk-heading-s govuk-!-margin-top-0 govuk-!-margin-bottom-2">
    <%= image_tag '/images/bookmark-icon.svg', class: 'app-track-tariff-changes-card__icon', alt: '', width: 24, height: 30, aria: { hidden: true } %>
    <%= govuk_link_to 'Track tariff changes',
                      myott_start_url(day: nil, month: nil, year: nil),
                      class: 'app-track-tariff-changes-card__link govuk-link--no-visited-state govuk-link--no-underline',
                      data: {
                        controller: 'analytics',
                        action: 'click->analytics#track',
                        analytics_event: 'homepage_track_tariff_changes_clicked',
                      } %>
  </h2>
  <p class="govuk-body govuk-!-margin-bottom-0">Stay up to date with the latest tariff changes.</p>
<% end %>
