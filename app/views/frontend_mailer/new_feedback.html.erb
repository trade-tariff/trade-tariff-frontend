<p>Hello,</p>

<p><%= @message %></p>

<% if @url %>
  <p>URL: <%= @url %></p>
<% end %>

<% if @query %>
  <p>Query: <%= @query %></p>
<% end %>

<% if @request_id %>
  <p>Search request ID: <%= @request_id %></p>
<% end %>

<% if @date %>
  <p>Date of trade: <%= @date %></p>
<% end %>

<p>Feature flags: <%= Array(@feature_flags).presence&.join(', ') || 'None' %></p>

<p>Found this page useful: <%= @page_useful if @page_useful %></p>
