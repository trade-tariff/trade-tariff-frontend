<div class="interactive-result">
  <div class="interactive-result__content">
    <h3 class="govuk-heading-s govuk-!-margin-bottom-1">
      <%= result.formatted_classification_description %>
    </h3>
    <p class="govuk-body-s govuk-!-margin-bottom-2">
      <strong>Commodity code:</strong> <%= result.goods_nomenclature_item_id %>
    </p>
    <p class="govuk-body-s govuk-!-margin-bottom-2<%= ' govuk-!-text-colour-secondary' unless duty_calculator_journey? %>">
      <%= result.formatted_self_text %>
    </p>
    <% result_link_data = {
      controller: 'guided-search-result',
      action: 'click->guided-search-result#select',
      guided_search_result_event_url_value: guided_search_event_path(day: nil, month: nil, year: nil),
      guided_search_result_request_id_value: @search.request_id,
      guided_search_result_goods_nomenclature_item_id_value: result.goods_nomenclature_item_id,
      guided_search_result_rank_value: rank,
      guided_search_result_confidence_value: result.try(:confidence).to_s.downcase.presence || 'unknown',
    } %>
    <% if duty_calculator_journey? %>
      <% result_path = import_details_path(commodity_code: result.goods_nomenclature_item_id,
                                           day: @search.day,
                                           month: @search.month,
                                           year: @search.year) %>
      <%= govuk_link_to result_path, data: result_link_data do %>
        Calculate import costs on this commodity
        <span class="govuk-visually-hidden">: <%= strip_tags(result.formatted_classification_description).squish %></span>
      <% end %>
    <% else %>
      <%= govuk_link_to "View this commodity code",
          commodity_path(result.goods_nomenclature_item_id, request_id: @search.request_id),
          data: result_link_data,
          new_tab: true %>
    <% end %>
  </div>
  <% if SearchResultsHelper::CONFIDENCE_LEVELS.key?(result.try(:confidence).to_s.capitalize) %>
    <div class="interactive-result__confidence">
      <%= render_confidence_meter(result.confidence) %>
    </div>
  <% end %>
</div>
