<% content_for :title, @question.text %>
<% content_for :back_link do %>
  <%= back_link vat_guidance_prototype_root_path %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <span class="govuk-caption-xl"><%= @journey.title %> prototype</span>

    <%= form_for @answer_form,
                 url: vat_guidance_prototype_answer_path,
                 builder: GOVUKDesignSystemFormBuilder::FormBuilder do |form| %>
      <%= form.govuk_error_summary %>
      <%= form.govuk_collection_radio_buttons :answer,
                                               @answer_form.options,
                                               :id,
                                               :name,
                                               legend: { text: @question.text, size: 'xl', tag: 'h1' },
                                               hint: { text: @question.hint },
                                               include_hidden: true %>
      <%= form.govuk_submit 'Continue' %>
    <% end %>

    <p class="govuk-body-s">
      Content version <%= @journey.content_version %>;
      based on guidance from <%= @journey.guidance_version_from.to_fs(:long) %>;
      commodity mapping effective from <%= @journey.applicability_from.to_fs(:long) %>.
    </p>
  </div>
</div>
