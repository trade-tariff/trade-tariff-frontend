<% cacheable = @trade_date_error.nil? && params[:request_id].blank? && params.values.compact.none? { |v| v.is_a?(ActionController::Parameters) } %>

<%# These are always needed regardless of cache state — set them before the cache block. %>
<% content_for :title, strip_tags(commodity_title(declarable)) %>
<% content_for :head do %>
  <meta name="description" content="<%= declarable.description_plain %>">
<% end %>
<% content_for :bodyClasses, "page--wide" %>

<% if @trade_date_error %>
  <% content_for :before_main_content do %>
    <div class="govuk-error-summary" data-module="govuk-error-summary">
      <div role="alert">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            <li><a href="#day"><%= @trade_date_error %></a></li>
          </ul>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<div data-controller="commodity-page-analytics"
     data-commodity-page-analytics-commodity-code-value="<%= declarable.code %>">
  <div data-guided-search-validation-page-content>
    <% if @show_commodity_search_link %>
      <div data-controller="commodity-search" data-action="keydown@window->commodity-search#keydown">
        <%= render 'commodities/header', commodity_code: declarable.code %>
        <%= render 'commodities/search' %>
      </div>
    <% else %>
      <%= render 'commodities/header', commodity_code: declarable.code %>
    <% end %>

    <% resilient_cache_if(cacheable, commodity_cache_key(show_commodity_search_link: @show_commodity_search_link)) do %>
      <% declarable.critical_footnotes.each do |footnote| %>
        <%= render 'footnotes/critical_warning', footnote: footnote %>
      <% end %>

      <%= govuk_details(
            summary_text: 'View Section, Chapter, Heading...',
            classes: 'commodity-hierarchy-details govuk-!-margin-bottom-5',
            html_attributes: {
              data: {
                controller: 'commodity-hierarchy',
                commodity_page_analytics_target: 'hierarchy',
                action: 'toggle->commodity-hierarchy#remember toggle->commodity-page-analytics#trackHierarchyToggle click->commodity-page-analytics#trackHierarchyLink',
              },
            },
          ) do %>
        <%= render 'goods_nomenclatures/ancestors', goods_nomenclature: declarable %>
      <% end %>

      <%= render 'shared/context_tables/commodity' %>

      <%= render 'declarables/declarable',
                declarable: declarable,
                xi_declarable: xi_declarable,
                uk_declarable: uk_declarable,
                rules_of_origin_schemes: @rules_of_origin_schemes,
                roo_all_schemes: @roo_all_schemes %>

      <%= render 'commodities/help_popup' %>
    <% end %>
  </div>
  <% if @show_commodity_search_link %>
    <div data-guided-search-validation-loading-page class="govuk-!-display-none">
      <%= render 'search/interactive_search_thinking' %>
    </div>
  <% end %>
</div>
