<%= measure_inset(id: 'duty-calculator', classes: 'measure-inset--calculator') do %>
  <%= image_tag 'calculator-icon.svg', alt: '', class: 'measure-inset--calculator__icon', width: 41, height: 50 %>
  <div class="measure-inset--calculator__content">
    <h4 class="govuk-heading-m">Calculate import costs</h4>
    <p class="measure-inset--calculator__description">Provide details to get a calculation of import duties and taxes.</p>
    <p class="measure-inset--calculator__link-container">
      <%= govuk_link_to import_date_path(commodity_code: declarable_code), id: 'duty-calculator-link', class: 'measure-inset--calculator__link' do %>
        <%= image_tag 'arrow-icon.svg', alt: '', class: 'measure-inset--calculator__arrow', width: 30, height: 30 %>
        <span>Start a duty calculation</span>
      <% end %>
    </p>
  </div>
<% end %>
