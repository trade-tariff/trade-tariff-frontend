<section data-commodity-page-analytics-target="tariffSection"
         data-analytics-exposure-event="commodity_tariff_section_shown"
         data-analytics-section="<%= local_assigns[:css_id] %>"
         data-action="click->commodity-page-analytics#trackTariffSectionInteraction">
  <h3 class="govuk-heading-m govuk-!-margin-top-5 govuk-!-margin-bottom-3" id=<%= local_assigns[:css_id] %>>
    <%= local_assigns[:caption] %>
  </h3>

  <% if local_assigns[:information] %>
    <div class="govuk-body"><%= sanitize local_assigns[:information] %></div>
  <% end %>

  <% if local_assigns[:import_duties] %>
    <%= render 'measures/grouped/import_duties',
               declarable: declarable,
               standard_collection: standard_collection,
               preferential_collection: preferential_collection,
               show_duty_calculator: show_duty_calculator,
               roo_schemes: roo_schemes %>
  <% else %>
    <%= render 'measures/grouped/vat_excise', uk_declarable: uk_declarable, declarable_code: uk_declarable.code if local_assigns[:vat_excise] && local_assigns[:uk_declarable] %>
    <%= render 'measures/grouped/credibility_checks' if local_assigns[:credibility_checks] %>
    <%= render 'measures/grouped/measure_table',
               collection: collection,
               hide_duty_rate: local_assigns[:hide_duty_rate],
               roo_schemes: local_assigns[:roo_schemes] %>
  <% end %>
</section>
