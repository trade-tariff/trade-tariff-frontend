<div data-controller="analytics"
     data-analytics-exposure-event-value="duty_calculator_started"
     data-analytics-context-value="<%= { commodity_code: user_session.commodity_code }.to_json %>">
<%= govuk_back_link(href: @step.previous_step_path) %>

<%= form_for @step, url: import_details_path, html: { novalidate: true } do |f| %>
  <%= f.govuk_error_summary %>
  <span class="govuk-caption-xl"><%= t('duty_calculator.shared.ux_caption') %></span>
  <h1 class="govuk-heading-xl">Tell us about this import</h1>
  <p class="govuk-body-l">Enter details of your trade for information about duties, quotas, VAT and trade remedies.</p>

  <%= f.govuk_collection_radio_buttons :import_destination,
    DutyCalculator::Steps::ImportDestination::OPTIONS, :id, :name,
    inline: true,
    legend: { text: 'Which part of the UK are you importing into?', size: 'm', tag: 'h2' },
    hint: { text: "The duty charged depends on the part of the UK you're importing to." } %>

  <% country_lists = @step.country_lists.transform_values { |options| options.map { |option| [option.id, option.name] } } %>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds" id="import-details-country" data-country-lists="<%= country_lists.to_json %>">
      <%= f.govuk_collection_select :country_of_origin,
        @step.country_options_for(@step.import_destination), :id, :name,
        options: { include_blank: true },
        label: { text: 'What is the country of origin?', size: 'm', tag: 'h2' },
        hint: { text: 'Duty depends on the origin of the goods. This might be different from the country they are sent from.' } %>

      <%= govuk_details(summary_text: 'Understand rules of origin') do %>
        <p class="govuk-body">Origin refers to the country or customs area where goods come from or are made.</p>
        <p class="govuk-body">Preferential rules of origin apply to countries and trading areas where there is a trade agreement. You will need to prove the origin to claim the preferential tariff.</p>
        <p class="govuk-body">Non-preferential rules of origin apply to all other countries.</p>
        <p class="govuk-body">Certificates of origin are available for both preferential and non-preferential origin. However, certificates for non-preferential origin are generally not required.</p>
        <p class="govuk-body">For more specific information on rules of origin, from the commodity code page go to the Origin section to see non-preferential rules. For preferential rules, you will need to select the country of origin.</p>
        <p class="govuk-body"><%= govuk_link_to 'Understand rules of origin', '/howto/origin', new_tab: true %></p>
      <% end %>
    </div>
  </div>

  <%= f.govuk_date_field :import_date,
    legend: { text: 'Date of import', size: 'm', tag: 'h2' },
    hint: { text: safe_join(['Duties and quotas can change over time. Enter the date you think your goods will enter the UK.', tag.br, 'Use the format day, month, year, for example, 27 3 2021.']) } %>
  <% if @commodity_validity_periods.present? %>
    <p class="govuk-body">
      This commodity code is available for these periods:
    </p>
    <%= govuk_list @commodity_validity_periods.map { |period|
      if period.end_date.present?
      safe_join(['From ', period.start_date.to_formatted_s(:long), ' to ', period.end_date.to_formatted_s(:long)])
      else
      safe_join(['From ', period.start_date.to_formatted_s(:long), ' onwards'])
      end
    }, type: :bullet %>
  <% end %>

  <%= f.govuk_submit %>
<% end %>
</div>
