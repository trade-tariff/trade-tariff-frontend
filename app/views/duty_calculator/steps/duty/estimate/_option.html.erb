<% name = duty_estimate_name(option) %>
<% reduced_rate = reduced_duty_estimate?(option) %>

<section id="<%= option.type %>" class="govuk-!-margin-bottom-8">
  <% if duty_estimate_content_key(option) == 'third_country_tariff_third_country_tariff' %>
    <h2 class="govuk-heading-m">Estimated duty and VAT using standard duty</h2>
  <% else %>
    <%= content_tag(reduced_rate ? :h3 : :h2, name, class: 'govuk-heading-m') %>
  <% end %>
  <%= duty_estimate_introduction(option) %>

  <% if option.values.present? %>
    <%= measure_inset(classes: 'duty-estimate-panel') do %>
      <%= image_tag('calculator-blue.svg', alt: '', width: 40, height: 48) %>
      <div>
        <div class="govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1"><%= name %></div>
        <div class="govuk-heading-l duty-estimate__amount"><%= number_to_currency(option.duty_and_vat_total) %></div>
      </div>
    <% end %>

    <%= govuk_details(classes: 'duty-estimate-calculations', summary_text: safe_join([tag.span('Show calculations', class: 'duty-estimate-calculations__show'), tag.span('Hide calculations', class: 'duty-estimate-calculations__hide')])) do %>
      <%= content_tag(reduced_rate ? :h4 : :h3, name, class: 'govuk-heading-s') %>
      <%= duty_estimate_explanation(option) %>

      <table class="govuk-table govuk-table--m">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Data</th>
            <th scope="col" class="govuk-table__header">Calculation</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Value</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          <%= render partial: 'duty_calculator/steps/duty/calculations/option_row', collection: option.values, as: :row %>
        </tbody>
      </table>

      <% if option.show_rules_of_origin? && scheme_for(option, @rules_of_origin_schemes).present? %>
        <%= render partial: 'duty_calculator/steps/duty/calculations/rules_of_origin_scheme', locals: { scheme: scheme_for(option, @rules_of_origin_schemes) } %>
      <% end %>
    <% end %>
  <% else %>
    <%= duty_estimate_explanation(option) %>
  <% end %>
</section>
