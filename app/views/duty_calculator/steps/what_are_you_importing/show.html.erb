<%= govuk_back_link(href: @step.previous_step_path) %>

<div data-guided-search-validation-page-content>
  <%= form_for @step, url: what_are_you_importing_search_path,
        html: { novalidate: true, id: 'duty-calculator-search' },
        data: {
          controller: 'guided-search-validation queued-search',
          guided_search_event_url: guided_search_event_path,
          queued_search_url_value: queue_guided_search_path,
          queued_search_direct_exact_code_value: true,
          action: 'submit->guided-search-validation#validateAndSubmit guided-search:submit->queued-search#submit queued-search:error->guided-search-validation#restore',
        } do |f| %>
    <div data-guided-search-validation-target="formContent">
      <%= render 'search/queued_search_error' %>
      <%= f.govuk_error_summary %>

      <span class="govuk-caption-xl"><%= t('duty_calculator.shared.ux_caption') %></span>
      <h1 class="govuk-heading-xl">What are you importing?</h1>
      <p class="govuk-body-l">
        Describe the goods you are importing. We’ll use this to help find the right commodity code for your cost estimate. If you already know it, you can enter the commodity code.
      </p>

      <h2 class="govuk-heading-m">
        <%= govuk_tag(text: 'BETA', colour: 'magenta', classes: 'govuk-!-margin-right-1') %>
        AI-assisted search
      </h2>

      <%= hidden_field_tag :interactive_search, 'true', data: { guided_search_validation_target: 'hiddenField' } %>
      <% if user_session.import_date.present? %>
        <%= hidden_field_tag :year, user_session.import_date.year %>
        <%= hidden_field_tag :month, user_session.import_date.month %>
        <%= hidden_field_tag :day, user_session.import_date.day %>
      <% end %>
      <%= f.govuk_text_area :search_term,
            name: 'q',
            label: { text: 'Describe the goods or enter a 10 digit commodity code' },
            hint: { text: 'For example, 55" 4K Ultra HD OLED Smart TV or 8528 72 40 00' },
            rows: 5,
            form_group: { data: { guided_search_validation_target: 'formGroup' } },
            data: { guided_search_validation_target: 'textarea' } %>

      <div class="govuk-button-group">
        <%= f.govuk_submit 'Continue' %>
      </div>
    </div>
  <% end %>
</div>

<div data-guided-search-validation-loading-page class="govuk-!-display-none">
  <%= render 'search/interactive_search_thinking' %>
</div>
