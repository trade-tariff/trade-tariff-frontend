<% content_for :title, "Feature flags | #{default_title}" %>

<div class="govuk-width-container">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Feature flags</h1>

      <p class="govuk-body">
        Opt into experimental features for this browser. Your preferences are remembered
        while this browser keeps its feature flag cookies, including after you close the browser.
        These features are under development and may change or be removed.
      </p>
      <p class="govuk-body">
        Opting in does not guarantee availability. Opting out turns a feature off for this
        browser, including when it is part of an automatic rollout or an active experiment.
      </p>

      <% if @optin_features.any? %>
        <dl class="govuk-summary-list">
          <% @optin_features.each do |feature| %>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">
                <%= feature[:name].tr('_', ' ').capitalize %>
              </dt>
              <dd class="govuk-summary-list__value">
                <p class="govuk-body">Saved preference: <%= { true => 'Opted in', false => 'Opted out' }.fetch(feature[:preference], 'No preference') %></p>
                <strong class="govuk-tag <%= feature[:enabled] ? 'govuk-tag--green' : 'govuk-tag--grey' %>">
                  <%= feature[:enabled] ? 'Available now' : 'Not available now' %>
                </strong>
              </dd>
              <dd class="govuk-summary-list__actions">
                <% opt_out = feature[:preference] == true || feature[:enabled] %>
                <%= button_to feature_flag_path(feature[:name]),
                              method: :patch,
                              params: { enabled: (!opt_out).to_s },
                              class: 'govuk-button govuk-button--secondary govuk-!-margin-bottom-0' do %>
                  <%= opt_out ? 'Opt out' : 'Opt in' %>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      <% elsif !@flagsmith_preferences_unavailable %>
        <p class="govuk-body">No features are currently available for opt-in.</p>
      <% end %>
    </div>
  </div>
</div>
