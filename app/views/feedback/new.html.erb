<% content_for :top_breadcrumbs do %>
  <%= generate_breadcrumbs(
    t('breadcrumb.feedback'),
    [
      [t('breadcrumb.home'), home_path],
      [t('breadcrumb.help'), help_path],
    ]
  ) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-three-quarters">
    <%= page_header 'Give feedback on Online Trade Tariff' %>

    <%= form_for @feedback, builder: GOVUKDesignSystemFormBuilder::FormBuilder do |f| %>
      <%= f.govuk_text_area :message,
                            label: { text: '<strong>Tell us how to improve our service</strong>'.html_safe },
                            hint: { text: 'Feedback is anonymous. Do not include any personal information.' },
                            max_chars: 500 %>

      <div hidden>
        <%= f.govuk_phone_field :telephone,
                             label: { text: 'Telephone (Do not fill out)',
                                      hidden: true },
                             width: 20,
                             max_chars: 100 %>
      </div>


      <%= f.hidden_field :page_useful %>
      <%= hidden_field_tag :feedback_url, @feedback.referrer %>
      <%= hidden_field_tag :feedback_query, @feedback.query %>
      <%= hidden_field_tag :search_request_id, @feedback.request_id %>
      <%= hidden_field_tag :feedback_date, @feedback.date %>
      <%= hidden_field_tag :feedback_feature_flags, Array(@feedback.feature_flags).join(',') %>

      <%= f.govuk_submit 'Submit feedback' %>
    <% end %>

    <h2 class="govuk-heading-m">Need help with something?</h2>
    <p class="govuk-body">
      If you have a question or need help using the Online Trade Tariff, use our
      <%= govuk_link_to 'enquiry form', enquiry_form_path_with_context, class: 'feedback-help-link' %>.
    </p>
  </div>
</div>
