{
  "namespace": "TradeTariff/PageVisits",
  "service": "frontend",
  "metric": "PageRequests",
  "bot_pattern": "bot|crawler|spider|headless|synthetic|healthcheck",
  "excluded_controller_pattern": "^(Myott::|BasicSessionsController|HealthcheckController|Cookies::)",
  "coverage": {
    "present": "With session ID",
    "missing": "Missing ID"
  },
  "mapping": {
    "mapped": "Mapped",
    "unmapped": "Unmapped"
  },
  "statuses": [
    {
      "id": "server_error",
      "label": "5xx errors",
      "minimum": 500,
      "color": "#d62728"
    },
    {
      "id": "client_error",
      "label": "4xx errors",
      "minimum": 400,
      "color": "#1f77b4"
    },
    {
      "id": "redirect",
      "label": "3xx redirects",
      "minimum": 300,
      "color": "#ff7f0e"
    },
    {
      "id": "success",
      "label": "2xx success",
      "minimum": 0,
      "color": "#2ca02c"
    }
  ],
  "activities": [
    {
      "id": "search",
      "label": "Search",
      "color": "#ff9900",
      "matchers": [
        {
          "type": "page_key",
          "values": [
            "FindCommoditiesController#show",
            "SectionsController#index",
            "SearchController#search"
          ]
        }
      ]
    },
    {
      "id": "az",
      "label": "A-Z index",
      "color": "#bcbd22",
      "matchers": [
        {
          "type": "controller",
          "values": [
            "SearchReferencesController"
          ]
        }
      ]
    },
    {
      "id": "browse",
      "label": "Browse tariff",
      "color": "#1f77b4",
      "matchers": [
        {
          "type": "controller",
          "values": [
            "BrowseSectionsController",
            "SectionsController",
            "ChaptersController",
            "HeadingsController",
            "SubheadingsController"
          ]
        }
      ]
    },
    {
      "id": "commodity",
      "label": "Commodities",
      "color": "#e377c2",
      "matchers": [
        {
          "type": "page_key",
          "values": [
            "CommoditiesController#show"
          ]
        }
      ]
    },
    {
      "id": "calculator",
      "label": "Duty calculator",
      "color": "#8c564b",
      "matchers": [
        {
          "type": "controller_prefix",
          "values": [
            "DutyCalculator::"
          ]
        }
      ]
    },
    {
      "id": "tools",
      "label": "Tariff tools",
      "color": "#17becf",
      "matchers": [
        {
          "type": "page_key",
          "values": [
            "SearchController#quota_search",
            "SearchController#chemical_search",
            "PagesController#tools"
          ]
        },
        {
          "type": "controller",
          "values": [
            "AdditionalCodeSearchController",
            "CertificateSearchController",
            "FootnoteSearchController",
            "ExchangeRatesController",
            "SimplifiedProceduralValuesController"
          ]
        },
        {
          "type": "controller_prefix",
          "values": [
            "MeursingLookup::"
          ]
        }
      ]
    },
    {
      "id": "enquiry",
      "label": "Enquiry form",
      "color": "#9467bd",
      "matchers": [
        {
          "type": "controller",
          "values": [
            "ProductExperience::EnquiryFormController"
          ]
        }
      ]
    },
    {
      "id": "guidance",
      "label": "Help & guidance",
      "color": "#d62728",
      "matchers": [
        {
          "type": "page_key",
          "values": [
            "CommoditiesController#origin"
          ]
        },
        {
          "type": "controller_prefix",
          "values": [
            "RulesOfOrigin::",
            "GreenLanes::",
            "Pages::",
            "ProductExperience::"
          ]
        },
        {
          "type": "controller",
          "values": [
            "PagesController",
            "NewsItemsController",
            "FeedbackController",
            "AiSearchInformationController",
            "LiveIssuesController"
          ]
        }
      ]
    },
    {
      "id": "other",
      "label": "Other pages",
      "color": "#2ca02c",
      "matchers": []
    }
  ],
  "tariff_keys": [
    "BrowseSectionsController#index",
    "SectionsController#show",
    "ChaptersController#show",
    "HeadingsController#show",
    "SubheadingsController#show",
    "CommoditiesController#show"
  ],
  "fallbacks": {
    "duty_calculator": "Import duty calculator: other step",
    "rules_of_origin": "Rules of origin: guidance step",
    "green_lanes": "Check simplified processes eligibility",
    "enquiry": "Enquiry form",
    "unmapped": "Other public page (unmapped)",
    "enquiry_unmapped_step": "Enquiry form (unmapped step)"
  },
